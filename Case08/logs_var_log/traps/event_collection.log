  }
  mappings {
    event_id: 2
    login_type: 2
    pattern: "[a-zA-Z]{3}\\s{1,2}\\d{1,2} \\d{2}:\\d{2}:\\d{2} \\S+ (?P<comm>[^\\[]+)(\\[(?P<pid>\\d+)\\])?:\\s+\\S+: authentication failure; logname=\\S*\\s+uid=(?P<uid>\\d+)\\s+euid=(?P<euid>\\d+)\\s+tty=(?P<line>\\S*)\\s+ruser=\\S*\\s+rhost=(?P<ip>\\S*)\\S*\\s+user=(?P<username>\\S+)"
