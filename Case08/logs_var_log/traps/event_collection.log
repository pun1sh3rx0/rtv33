    pattern: "[a-zA-Z]{3}\\s{1,2}\\d{1,2} \\d{2}:\\d{2}:\\d{2} \\S+ (?P<comm>[^\\[]+)\\[(?P<pid>\\d+)\\]:\\s+(?P<outcome_reason>Failed password) for (?P<username>\\S+) from (?P<ip>\\S+) port (?P<port>\\d+) (?P<fingerprint>[^\\n]+)"
