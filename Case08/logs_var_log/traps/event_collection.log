    pattern: "[a-zA-Z]{3}\\s{1,2}\\d{1,2} \\d{2}:\\d{2}:\\d{2} \\S+ (?P<comm>[^\\[]+)\\[(?P<pid>\\d+)\\]:\\s+Connection closed by (?P<outcome_reason>invalid user) (?P<username>\\S+) (?P<ip>\\S+) port (?P<port>\\d+) \\[preauth\\]"
  }
  mappings {
